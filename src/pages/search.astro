---
import Base from '../layouts/Base.astro';
const BASE = import.meta.env.BASE_URL;
---
<Base title="Search">
  <h1>Search</h1>
  <link href={`${BASE}/pagefind/pagefind-ui.css`} rel="stylesheet" />
  <div id="search"></div>
  <script src={`${BASE}/pagefind/pagefind-ui.js`} is:inline></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      // pagefind-ui.js may load after DOMContentLoaded; poll briefly
      const tryInit = (n) => {
        if (window.PagefindUI) { new PagefindUI({ element: '#search' }); return; }
        if (n > 0) setTimeout(() => tryInit(n - 1), 100);
      };
      tryInit(50);
    });
  </script>
</Base>
