---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  const categories = [...new Set(recipes.flatMap(r => r.data.categories))];
  return categories.map(category => ({
    params: { category },
    props: { recipes: recipes.filter(r => r.data.categories.includes(category)) },
  }));
}
const { category, recipes } = Astro.props;
const BASE = import.meta.env.BASE_URL;
---
<Base title={`Category: ${category}`}>
  <h1>Category: {category}</h1>
  <ul>
    {recipes.map(r => <li><a href={`${BASE}/recipes/${r.id}/`}>{r.data.title}</a></li>)}
  </ul>
</Base>
